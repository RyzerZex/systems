generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model SystemEntry {
  id        String   @id @default(cuid())
  task      String
  minutes   Int
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
}
